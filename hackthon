  <footer class="footer shell">
    <span>BUILD WEEK · Campus Hackathon</span>
    <span>Have questions? Reach out to the event organizers.</span>
    <a href="#home">Back to top ↑</a>
  </footer>

  <script>
    const form = document.getElementById("registration-form");
    const teamSize = document.getElementById("team-size");
    const memberFields = document.getElementById("member-fields");
    const formStatus = document.getElementById("form-status");

    function renderMemberFields() {
      const count = Number(teamSize.value);
      memberFields.replaceChildren();

      for (let memberNumber = 2; memberNumber <= count; memberNumber += 1) {
        const field = document.createElement("div");
        field.className = "field";
        const label = document.createElement("label");
        const input = document.createElement("input");
        const inputId = `member-${memberNumber}`;

        label.htmlFor = inputId;
        label.textContent = `Member ${memberNumber} name`;
        input.id = inputId;
        input.name = `member${memberNumber}`;
        input.type = "text";
        input.autocomplete = "off";
        input.maxLength = 80;
        input.placeholder = "Full name";
        input.required = true;
        field.append(label, input);
        memberFields.append(field);
      }
    }

    teamSize.addEventListener("change", renderMemberFields);

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const registration = Object.fromEntries(new FormData(form).entries());
      const registrationsKey = "build-week-registrations";
      let registrations;

      try {
        registrations = JSON.parse(localStorage.getItem(registrationsKey) || "[]");
        if (!Array.isArray(registrations)) {
          throw new Error("Stored registration data is not a list.");
        }
        registrations.push({ ...registration, savedAt: new Date().toISOString() });
        localStorage.setItem(registrationsKey, JSON.stringify(registrations));
      } catch (error) {
        formStatus.dataset.kind = "error";
        formStatus.textContent = "Could not save your registration in this browser. Check your browser storage settings and try again.";
        console.error("Registration could not be saved.", error);
        return;
      }

      formStatus.dataset.kind = "success";
      formStatus.textContent = `Team "${registration.teamName}" saved on this device. This demo does not send your details to the organizers.`;
      form.reset();
      renderMemberFields();
    });
  </script>
</body>
