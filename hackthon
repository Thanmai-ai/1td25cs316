    <section class="content-section shell" id="prizes" aria-labelledby="prizes-title">
      <div class="prize-wrap">
        <div class="prize-copy">
          <span class="section-kicker">Build it. Pitch it. Win it.</span>
          <h2 id="prizes-title">Good ideas deserve the spotlight.</h2>
          <p>Top teams get recognized on stage, with prizes and campus-wide bragging rights. Final prize amounts will be announced by the organizers.</p>
        </div>
        <div class="prize-list" aria-label="Prize placements">
          <div class="prize-row"><span class="prize-place">01</span><span><span class="prize-name">First place</span><span class="prize-detail">The top solution, chosen by our judges</span></span><span class="prize-value">Grand prize</span></div>
          <div class="prize-row"><span class="prize-place">02</span><span><span class="prize-name">Second place</span><span class="prize-detail">A standout idea with real potential</span></span><span class="prize-value">Runner-up</span></div>
          <div class="prize-row"><span class="prize-place">03</span><span><span class="prize-name">Third place</span><span class="prize-detail">A thoughtful build worth celebrating</span></span><span class="prize-value">Third place</span></div>
        </div>
