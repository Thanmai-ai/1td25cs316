          <div class="event-detail"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m17-12a4 4 0 0 1 0 8m5 4v-2a4 4 0 0 0-3-3.87M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Teams of 2–4 students<span>Minimum 2 · Maximum 4 members</span></span></div>
        </div>
        <form class="form-card" id="registration-form">
          <h3>Team registration</h3>
          <p class="form-caption">Tell us who you are and what you want to build. All fields are required.</p>
          <div class="form-grid">
            <div class="field"><label for="team-name">Team name</label><input id="team-name" name="teamName" type="text" placeholder="e.g. The Debuggers" maxlength="60" required></div>
            <div class="field"><label for="project-track">Project category</label><select id="project-track" name="projectTrack" required><option value="" disabled selected>Select a track</option><option>AI for good</option><option>Campus & community</option><option>Open innovation</option></select></div>
            <div class="field"><label for="leader-name">Team lead name</label><input id="leader-name" name="leaderName" type="text" autocomplete="name" placeholder="Your full name" maxlength="80" required></div>
            <div class="field"><label for="leader-email">College email</label><input id="leader-email" name="leaderEmail" type="email" autocomplete="email" placeholder="you@college.edu" maxlength="120" required></div>
            <div class="field full"><label for="team-size">Team size</label><select id="team-size" name="teamSize" required><option value="" disabled selected>Choose 2, 3, or 4 members</option><option value="2">2 members</option><option value="3">3 members</option><option value="4">4 members</option></select><p class="team-hint">Team size must be between 2 and 4, including the team lead.</p></div>
            <div class="member-fields" id="member-fields" aria-live="polite"></div>
          </div>
          <div class="submit-row"><button class="button-primary" type="submit">Save registration <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button><p class="privacy-note">Demo form: your entry is saved only in this browser.</p></div>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
        </form>
